# Local Development Environment Variables
# Copy this file to .env.local and update values as needed

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_manager
DB_USER=postgres
DB_PASSWORD=postgres

# API Server Configuration
PORT=8000

# AWS Configuration (optional for local dev)
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# JWT Configuration
JWT_SECRET_KEY=local-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2160

# Cognito Configuration (mock for local dev)
COGNITO_USER_POOL_ID=local-dev-pool
COGNITO_REGION=eu-west-1

# Email Configuration (optional)
EMAIL_FROM=noreply@identity-manager.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Application Configuration
APP_NAME=Identity Manager
APP_VERSION=5.0.0
ENVIRONMENT=local-development
